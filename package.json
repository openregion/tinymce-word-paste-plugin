{
  "name": "@openregion/tinymce-word-paste-plugin",
  "version": "2.0.0",
  "description": "TinyMCE and HugeRTE plugin to paste from Word",
  "type": "commonjs",
  "main": "./dist/index.umd.js",
  "umd:main": "./dist/index.umd.js",
  "unpkg": "./dist/browser.umd.js",
  "module": "./dist/index.module.mjs",
  "types": "./dist/types/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "browser": {
      "import": "./dist/browser.module.mjs",
      "require": "./dist/browser.umd.js",
      "default": "./dist/browser.umd.js"
    },
    "import": "./dist/index.module.mjs",
    "require": "./dist/index.umd.js",
    "default": "./dist/index.umd.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:node": "rollup --config --configTarget node",
    "build:browser": "rollup --config --configTarget browser",
    "build": "rollup --config",
    "prepack": "npm run build",
    "release": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openregion/tinymce-word-paste-plugin.git"
  },
  "keywords": [
    "tinymce",
    "hugerte",
    "plugin",
    "paste",
    "word"
  ],
  "license": "LGPL-2.1",
  "bugs": {
    "url": "https://github.com/openregion/tinymce-word-paste-plugin/issues"
  },
  "homepage": "https://github.com/openregion/tinymce-word-paste-plugin#readme",
  "peerDependencies": {
    "hugerte": "^1",
    "tinymce": "^6.2.0 || ^7 || ^8"
  },
  "peerDependenciesMeta": {
    "tinymce": {
      "optional": true
    },
    "hugerte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "hugerte": "^1.0.14",
    "rollup": "^4.63.6",
    "tinymce": "^8.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
